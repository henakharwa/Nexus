# Postgres (packages/db)
DATABASE_URL=postgres://postgres:postgres@localhost:55432/mai_chat

# 32-byte key (base64), used to encrypt GitHub/Slack tokens at rest
# (AES-256-GCM, packages/db/src/crypto.ts). Generate your own with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# -- do not reuse this placeholder for anything real.
INTEGRATION_ENCRYPTION_KEY=

# Real-time chat server
CHAT_SERVER_PORT=4000

# LLM backend for the shared-chat agent (OpenAI-compatible /chat/completions).
#
# Defaults here to a local Ollama server: free, open-source, and with no
# rate limit or daily quota at all (unlike every hosted free tier -- the
# only limit becomes your own machine's speed). See README.md's "Running
# the agent for free, without a cloud API key" section for setup:
# install Ollama, `ollama pull qwen2.5:7b-instruct`, then
# `ollama create mai-agent -f scripts/ollama/Modelfile.mai-agent` (that
# Modelfile gives it a bigger context window than Ollama's silent
# 2048-token default -- see its comments for why that matters here).
AGENT_LLM_BASE_URL=http://localhost:11434/v1
AGENT_LLM_API_KEY=ollama
AGENT_LLM_MODEL=mai-agent
# 1024 -- there's no per-minute quota to share with conversation history
# locally, but CPU-only generation (no dedicated GPU) is slow enough that
# a shorter completion cap keeps replies from taking uncomfortably long.
# Raise this if a reply gets cut off mid tool call (a JSON-parsing error),
# lower it if replies feel slow.
AGENT_LLM_MAX_TOKENS=1024
# Matches the num_ctx set in scripts/ollama/Modelfile.mai-agent (8192).
# services/chat-server/src/agent.ts uses this to size how much
# conversation history fits alongside the tool schema and system prompt
# each turn. Raise both together if you configure a bigger context window.
AGENT_LLM_TPM_LIMIT=8192

# Agent turns (paid LLM calls) each person may start per hour, across all
# workspaces. Defaults to 60 when unset.
# AGENT_TURNS_PER_USER_PER_HOUR=60

# How long an agent action may wait for approval before it is cancelled
# (1 to 720 hours). Defaults to 24 when unset. See README's "Approval rules".
# ACTION_APPROVAL_TTL_HOURS=24

# Optional OpenAI-compatible paid primary. Keep the AGENT_LLM_* values above
# as the free fallback. Nexus switches only when the primary explicitly
# reports exhausted credits or quota; ordinary short-lived rate limits retry
# on the primary first.
# AGENT_LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
# AGENT_LLM_PRIMARY_API_KEY=
# AGENT_LLM_PRIMARY_MODEL=gpt-6-luna
# AGENT_LLM_PRIMARY_MAX_TOKENS=1024
# AGENT_LLM_PRIMARY_TPM_LIMIT=8192

# To use Groq's cloud free tier instead (faster replies, but a real rate
# limit/daily quota -- see the git history around 2026-09-20/21 for what
# that looked like in practice), comment out the AGENT_LLM_* lines above
# and uncomment these three instead:
# AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
# AGENT_LLM_API_KEY=
# AGENT_LLM_MODEL=openai/gpt-oss-20b
# AGENT_LLM_MAX_TOKENS=2048
# AGENT_LLM_TPM_LIMIT=8000

# To try Cerebras' cloud inference instead (also OpenAI-compatible,
# dedicated hardware -- see README for why this was worth trying against
# the CPU-only Ollama prefill bottleneck), get a free API key at
# https://cloud.cerebras.ai and uncomment these instead. Free-tier limits
# have changed more than once -- check the dashboard, don't trust a
# number written here.
# AGENT_LLM_BASE_URL=https://api.cerebras.ai/v1
# AGENT_LLM_API_KEY=
# AGENT_LLM_MODEL=gpt-oss-120b
# AGENT_LLM_MAX_TOKENS=2048
# AGENT_LLM_TPM_LIMIT=8192

# GitHub tools for the agent, via GitHub's official MCP server
# (github/github-mcp-server), run locally as a Docker container over
# stdio (`docker run -i --rm ... ghcr.io/github/github-mcp-server`) --
# see README.md's "GitHub tools via MCP server" section. Requires Docker
# Desktop installed AND RUNNING; without it, a connected GitHub
# integration is still saved fine, but the agent just won't have any
# GitHub tools available (server-side log: "GitHub MCP tools
# unavailable"). Leave this blank to use GitHub's own published image --
# only set it to pin a specific tag/digest instead.
GITHUB_MCP_DOCKER_IMAGE=
# A curated default (github-mcp-pool.ts's DEFAULT_GITHUB_TOOLS) is used
# when both of these are left blank -- read-only tools covering issues, pull
# requests, files, commits, branches, and GitHub Actions, sized to leave real room for
# conversation history inside AGENT_LLM_TPM_LIMIT above (the local Ollama
# default's whole 8192-token window is *not* enough for github-mcp-server's
# full "default" toolset -- verified 2026-09-21 against the real tool
# descriptions, comes out to 8-12k tokens by itself). Set GITHUB_TOOLS to
# your own comma-separated tool-name allow-list to override that default,
# or GITHUB_TOOLSETS to pull in a whole category
# (context/repos/issues/pull_requests/actions/... -- see
# https://github.com/github/github-mcp-server#available-toolsets) instead.
# Watch the chat-server's own logs after a chat message -- agent.ts prints
# the real measured token cost of whatever's configured here every turn,
# so you can see exactly how much (if any) history budget is left rather
# than guessing.
# GITHUB_TOOLS=
# GITHUB_TOOLSETS=

# Sign-in/sign-up -- every /workspaces route and the WebSocket chat require
# a real signed-in session (services/chat-server/src/auth.ts), no
# guest/anonymous fallback. Three ways in, all optional to configure
# independently (apps/web/app/_components/AuthForm.tsx shows only the
# ones GET /auth/providers reports as configured):
#
#   1. Email + password (services/chat-server/src/email-auth.ts) -- works
#      out of the box, nothing below to set up. scrypt-hashed, rate
#      limited per-IP and per-account.
#   2. "Sign in with GitHub" -- GITHUB_OAUTH_CLIENT_ID/SECRET below.
#   3. "Sign in with Google" -- GOOGLE_OAUTH_CLIENT_ID/SECRET below.
#
# Leaving ALL THREE OAuth client id/secret pairs blank still leaves email
# + password working; leaving just one blank only disables that one
# provider's button.

# GitHub OAuth login -- this SAME OAuth App serves two different flows,
# both against the same Client ID/Secret below:
#   1. The "+ Add channel -> GitHub" per-workspace repo *integration* login
#      (services/chat-server/src/github-oauth.ts).
#   2. "Sign in with GitHub" -- real user accounts (services/chat-server/src/auth.ts).
# Register a free OAuth App at https://github.com/settings/developers with:
#   Homepage URL:                http://localhost:3000
#   Authorization callback URL:  http://localhost:4000/auth/github/callback
#   Authorization callback URL:  http://localhost:4000/auth/login/github/callback
# (GitHub OAuth Apps have supported multiple registered redirect URIs
# since 2026-08-14 -- add BOTH callback URLs above under the app's
# settings, not just one; each flow only works against its own exact
# redirect URI.) Then paste the Client ID and Client Secret below. Leaving
# these blank just means the GitHub sign-in button isn't offered -- email
# + password (and Google, if configured) still work.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth login -- "Sign in with Google" (services/chat-server/src/google-auth.ts).
# PKCE + a browser-bound state cookie; identity is taken only from
# Google's authenticated userinfo endpoint with email_verified=true, never
# from decoding an unverified ID token. Register an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials (type: "Web
# application") with:
#   Authorized redirect URI:  http://localhost:4000/auth/login/google/callback
# Then paste the Client ID and Client Secret below. Leaving these blank
# just means the Google sign-in button shows "Google sign-in isn't
# configured yet" -- email + password (and GitHub, if configured) still
# work.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# This server's own externally-reachable base URL, used to build the
# GitHub/Google OAuth redirect_uris above -- must match the callback URLs
# registered on the GitHub OAuth App / Google OAuth Client exactly
# (including the port).
CHAT_SERVER_PUBLIC_URL=http://localhost:4000
# Where the browser gets sent back to once GitHub, Google, or Slack login
# finishes (the Next.js app's own origin).
WEB_APP_URL=http://localhost:3000

# Slack login -- the ONLY way to connect Slack (no pasted-token fallback;
# Slack's own official MCP server requires a real user access token from
# this exact OAuth flow). Register a Slack App at https://api.slack.com/apps
# (an "internal" app to your own workspace qualifies) with:
#   Redirect URL:  http://localhost:4000/auth/slack/callback
#   User scopes:   search:read.public, search:read.private,
#                  channels:history, groups:history, mpim:history,
#                  im:history, chat:write, users:read
# then paste the Client ID and Client Secret from its "Basic Information"
# page below. See the real .env's copy of this comment for the full
# explanation, including a Slack dashboard quirk around a minimal bot
# scope that this project's code doesn't actually depend on.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
# Leave blank to use Slack's real https://mcp.slack.com/mcp.
SLACK_MCP_SERVER_URL=

# apps/web
NEXT_PUBLIC_CHAT_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_CHAT_SERVER_WS_URL=ws://localhost:4000

# Outbound email -- password reset and email-verification links
# (services/chat-server/src/mailer.ts). Leave blank for local dev: the
# email is printed to this server's own
# terminal (including the real link) instead of delivered, so you can
# click it yourself without any provider account. For a real deployment,
# get a free API key at https://resend.com and set these two:
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Alternative: Gmail. Set GMAIL_SMTP_USER plus either an App Password for
# SMTP or all three Gmail API values. The Gmail API option is suitable when
# SMTP is unavailable from the host.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=

# Production startup check (services/chat-server/src/config-check.ts): with
# NODE_ENV=production the server refuses to start without DATABASE_URL,
# INTEGRATION_ENCRYPTION_KEY and a non-localhost WEB_APP_URL, and warns if
# CHAT_SERVER_PUBLIC_URL is missing.

# Proxy hops in front of the chat server, so per-IP limits see real client
# addresses. Defaults to 0; docker-compose.oracle.yml sets 1 (Caddy).
# TRUST_PROXY_HOPS=1

# Live chat across several server processes: "postgres" shares live events
# and the one-agent-turn lock through the database (default in production);
# "memory" keeps them in this process (default in development).
# REALTIME_BUS=postgres

# Optional error tracking with Sentry (sentry.io). Leave blank to turn it off;
# nothing is loaded or sent without a DSN. Reports never include cookies,
# headers, request bodies, query strings, chat content or local variables.
# SENTRY_DSN=                      # chat server errors
# SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_DSN=          # browser errors (read when the web app is built)
