FROM ghcr.io/github/github-mcp-server:latest AS github_mcp

FROM node:22-bookworm-slim
WORKDIR /app

COPY . .
RUN npm ci \
  && npm run build --workspace=packages/shared-types \
  && npm run build --workspace=packages/db \
  && npm run build --workspace=packages/integrations \
  && npm run build --workspace=services/chat-server

# Managed platforms cannot launch Docker containers from inside a service.
# Include GitHub's official MCP binary and run it directly instead.
COPY --from=github_mcp /server/github-mcp-server /usr/local/bin/github-mcp-server
ENV NODE_ENV=production
ENV GITHUB_MCP_COMMAND=github-mcp-server
# Run as the image's unprivileged "node" user, not root.
USER node
CMD ["npm", "run", "start:server"]
