{
  "name": "multiplayer-ai-chat",
  "private": true,
  "workspaces": [
    "packages/shared-types",
    "packages/db",
    "packages/integrations",
    "services/chat-server",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/shared-types --workspace=packages/db --workspace=packages/integrations --if-present && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:full": "node scripts/test-with-db.mjs",
    "migrate": "npm run migrate --workspace=packages/db",
    "db:reset": "node scripts/reset-database.mjs",
    "db:start": "node scripts/dev-db.mjs",
    "dev:server": "npm run dev --workspace=services/chat-server",
    "dev:web": "npm run dev --workspace=apps/web",
    "start:server": "npm run start --workspace=services/chat-server",
    "start:web": "npm run start --workspace=apps/web",
    "migrate:status": "npm run migrate:status --workspace=packages/db",
    "migrate:down": "npm run migrate:down --workspace=packages/db",
    "format": "prettier --write \"apps/web/app/**/*.{ts,tsx,css}\" \"apps/web/lib/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"apps/web/app/**/*.{ts,tsx,css}\" \"apps/web/lib/**/*.{ts,tsx}\"",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "3.9.10"
  }
}
