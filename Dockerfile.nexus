# Base images: pin each to an exact digest (Security Validation scope 13,
# pending the digests from the running server) so a rebuild never silently
# picks up a different upstream image.
FROM ghcr.io/github/github-mcp-server:latest AS github_mcp
FROM caddy:2-alpine AS caddy

FROM node:25-bookworm-slim
WORKDIR /app
ARG NEXT_PUBLIC_CHAT_SERVER_URL
ARG NEXT_PUBLIC_CHAT_SERVER_WS_URL
ARG NEXT_PUBLIC_SENTRY_DSN=
ARG NEXT_PUBLIC_EMAIL_VERIFICATION_ENABLED=true
ARG NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
ENV NEXT_PUBLIC_CHAT_SERVER_URL=$NEXT_PUBLIC_CHAT_SERVER_URL
ENV NEXT_PUBLIC_CHAT_SERVER_WS_URL=$NEXT_PUBLIC_CHAT_SERVER_WS_URL
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_EMAIL_VERIFICATION_ENABLED=$NEXT_PUBLIC_EMAIL_VERIFICATION_ENABLED
ENV NEXT_PUBLIC_SENTRY_ENVIRONMENT=$NEXT_PUBLIC_SENTRY_ENVIRONMENT
COPY . .
RUN npm ci && npm run build --workspace=packages/shared-types && npm run build --workspace=packages/db && npm run build --workspace=packages/integrations && npm run build --workspace=services/chat-server && npm run build --workspace=apps/web
COPY --from=github_mcp /server/github-mcp-server /usr/local/bin/github-mcp-server
COPY --from=caddy /usr/bin/caddy /usr/local/bin/caddy
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates libcap2-bin \
  && setcap -r /usr/local/bin/caddy \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
ENV GITHUB_MCP_COMMAND=github-mcp-server

# Run as the image's unprivileged "node" user (uid 1000), not root.
# - The application code stays owned by root, so the running process can't
#   modify it; only Next.js' build folder (its runtime cache) is writable.
# - Caddy keeps its certificates in /data/caddy and its config in
#   /config/caddy (the docker-compose volumes).
# - Caddy still listens on 80/443: docker-compose.oracle.yml lets
#   unprivileged processes bind low ports inside the container.
RUN chmod +x scripts/start-nexus.sh \
  && mkdir -p /data/caddy /config/caddy \
  && chown -R node:node /data /config /app/apps/web/.next
ENV HOME=/home/node
ENV XDG_DATA_HOME=/data
ENV XDG_CONFIG_HOME=/config
USER node
CMD ["./scripts/start-nexus.sh"]
