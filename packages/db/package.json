{
  "name": "@mai-chat/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --no-file-parallelism",
    "migrate": "tsx src/migrate.ts",
    "migrate:status": "tsx src/migrate.ts status",
    "migrate:down": "tsx src/migrate.ts down",
    "rotate:integration-keys": "tsx src/rotate-integration-keys.ts"
  },
  "dependencies": {
    "@mai-chat/shared-types": "0.1.0",
    "dotenv": "18.0.9",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
